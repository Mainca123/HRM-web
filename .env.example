# URL gốc của Backend API (không có dấu / ở cuối)
# Ví dụ: https://hrm-tmyj.onrender.com hoặc http://localhost:5000
# - Nếu điền giá trị: frontend sẽ gọi trực tiếp tới URL này.
# - Nếu để trống: frontend sẽ gọi qua đường dẫn tương đối /api (đi qua proxy Vite khi dev hoặc Nginx khi chạy Docker).
VITE_API_BASE_URL=https://hrm-tmyj.onrender.com

# Đích proxy cho Vite dev server khi VITE_API_BASE_URL để trống
VITE_API_PROXY_TARGET=https://hrm-tmyj.onrender.com
